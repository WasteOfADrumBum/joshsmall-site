{
  "name": "joshsmall-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON 'src/**/*.test.ts'",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:cross": "playwright test --project=firefox --project=webkit",
    "test:prod": "playwright test --config=playwright.prod.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "format:check": "prettier --check e2e scripts playwright.config.ts playwright.prod.config.ts .github",
    "format": "prettier --write e2e scripts playwright.config.ts playwright.prod.config.ts .github",
    "links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-links.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
